# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Twitch Configuration
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_TOKEN=your_twitch_token_here
TWITCH_NICK=your_twitch_username_here
TWITCH_CHANNEL=your_twitch_channel_here
TWITCH_PREFIX=!

# VTube Studio Configuration
VTUBESTUDIO_WS_URL=ws://localhost:8001
VTUBE_STUDIO_IP=127.0.0.1
VTUBE_STUDIO_PORT=8001

# Audio Configuration
SAMPLE_RATE=44100
CHUNK_SIZE=1024
SILENCE_THRESHOLD=300
SILENCE_DURATION=2.0

# TTS Configuration
TTS_ENGINE=coqui
TTS_VOLUME=1.0
COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC
COQUI_VOCODER=vocoder_models/en/ljspeech/hifigan_v2

# Input Configuration
HOTKEY_MODE=False
RECORDING_HOTKEY=f9
MICROPHONE_DEVICE_ID=

# Logging
LOG_FILE=vtuber_bot.log
LOG_LEVEL=INFO

# AI Configuration
AI_COMMAND_PREFIX=!AI
AI_CHAT_RESPONSE=False
USE_ASSISTANT_API=False
OPENAI_ASSISTANT_ID=your_assistant_id_here
AI_SYSTEM_INSTRUCTIONS=You are a friendly and engaging VTuber AI assistant. Your responses should be concise, entertaining, and suitable for streaming platforms. Keep your responses under 2-3 sentences when possible. You can be playful and show personality.

# Message Queue Configuration
ENABLE_MESSAGE_QUEUE=True
MAX_QUEUE_SIZE=5
QUEUE_FULL_MESSAGE=The message queue is full
