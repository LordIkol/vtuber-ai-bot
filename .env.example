# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Twitch Configuration
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_TOKEN=your_twitch_token_here
TWITCH_NICK=your_twitch_username_here
TWITCH_CHANNEL=your_twitch_channel_here
TWITCH_PREFIX=!

# VTube Studio Configuration
VTUBESTUDIO_WS_URL=ws://localhost:8001
VTUBE_STUDIO_IP=localhost
VTUBE_STUDIO_PORT=8001

# Audio Configuration
SAMPLE_RATE=16000
CHUNK_SIZE=1024
SILENCE_THRESHOLD=500
SILENCE_DURATION=1.0
TTS_VOLUME=1.0

# Input Configuration
HOTKEY_MODE=True
RECORDING_HOTKEY=space

# Logging
LOG_FILE=vtuber_bot.log
LOG_LEVEL=INFO

# AI Command
AI_COMMAND_PREFIX=!AI
AI_CHAT_RESPONSE=True

# Message Queue Configuration
ENABLE_MESSAGE_QUEUE=True
MAX_QUEUE_SIZE=10
QUEUE_FULL_MESSAGE=Sorry, the message queue is full. Please try again later.
